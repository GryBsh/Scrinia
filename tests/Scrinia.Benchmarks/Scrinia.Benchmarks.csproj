<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <!-- BenchmarkDotNet builds a child process with its own measurements; run with -c Release. -->
    <ServerGarbageCollection>true</ServerGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" Version="0.15.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Scrinia.Core\Scrinia.Core.csproj" />
    <!-- HintReadPathBenchmarks measures HintCommand, which lives in the CLI. Referencing the exe
         project is what makes the benchmark measure the code `scri hint` actually runs rather than
         a re-implementation of it in this project that would drift. -->
    <ProjectReference Include="..\..\src\Scrinia\Scrinia.csproj" />
  </ItemGroup>

</Project>
