<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
    <PackageLicenseExpression>BSD-3-Clause</PackageLicenseExpression>
    <!-- Long-running performance benchmarks are opt-in. An explicit filter replaces this default. -->
    <VSTestTestCaseFilter Condition="'$(VSTestTestCaseFilter)' == ''">Category!=LongRunningBenchmark</VSTestTestCaseFilter>
  </PropertyGroup>

  <ItemGroup>
    <None Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="coverlet.collector" Version="6.0.4">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="FluentAssertions" Version="6.12.2" />
    <PackageReference Include="Xunit.SkippableFact" Version="1.5.61" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Scrinia.Core\Scrinia.Core.csproj" />
    <ProjectReference Include="..\..\src\Scrinia.Plugin.Embeddings\Scrinia.Plugin.Embeddings.csproj" />
    <!-- EmbeddingsTools (the plugin's MCP wire surface) lives in the CLI project and had no direct
         coverage, though this branch added its `index` tool and rewrote its Search projection. -->
    <ProjectReference Include="..\..\src\Scrinia.Plugin.Embeddings.Cli\Scrinia.Plugin.Embeddings.Cli.csproj" />
    <ProjectReference Include="..\Scrinia.Tests\Scrinia.Tests.csproj" />
  </ItemGroup>
  <!-- Resolve the child process from this build, never from another configuration's bin tree.
       The normal reference also retains direct EmbeddingsTools wire-surface coverage. -->
  <Target Name="ResolveEmbeddingsCliTestArtifact"
          BeforeTargets="GetAssemblyAttributes;GenerateAssemblyInfo"
          DependsOnTargets="ResolveProjectReferences">
    <PropertyGroup>
      <_EmbeddingsCliRuntimeIdentifier Condition="'$(RuntimeIdentifier)' != ''">$(RuntimeIdentifier)</_EmbeddingsCliRuntimeIdentifier>
      <_EmbeddingsCliRuntimeIdentifier Condition="'$(_EmbeddingsCliRuntimeIdentifier)' == ''">$(NETCoreSdkPortableRuntimeIdentifier)</_EmbeddingsCliRuntimeIdentifier>
    </PropertyGroup>
    <MSBuild Projects="$(MSBuildThisFileDirectory)..\..\src\Scrinia.Plugin.Embeddings.Cli\Scrinia.Plugin.Embeddings.Cli.csproj"
             Targets="GetTargetPath"
             Properties="Configuration=$(Configuration);RuntimeIdentifier=$(_EmbeddingsCliRuntimeIdentifier)">
      <Output TaskParameter="TargetOutputs" ItemName="_EmbeddingsCliTargetPath" />
    </MSBuild>
    <Error Condition="'@(_EmbeddingsCliTargetPath->Count())' != '1'"
           Text="Exactly one embeddings CLI TargetPath must be supplied by this build." />
    <Error Condition="!Exists('%(_EmbeddingsCliTargetPath.Identity)')"
           Text="The embeddings CLI TargetPath does not exist: %(_EmbeddingsCliTargetPath.Identity)" />
    <ItemGroup>
      <AssemblyMetadata Include="EmbeddingsCliPath" Value="@(_EmbeddingsCliTargetPath)" />
    </ItemGroup>
  </Target>
</Project>
