<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Scrinia.TestDoubles</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
    <PackageLicenseExpression>BSD-3-Clause</PackageLicenseExpression>
    <!--
      This project's name doesn't end in .Tests or .Benchmarks, so Directory.Build.props'
      suffix match (see its :17-19 comment) puts it in the strict TreatWarningsAsErrors
      branch by accident — even though it exists mainly to host test doubles and should get
      the same advisory-only treatment as the test projects. Opting out
      explicitly here so the next added double gets a warning, not a hard build break.
      It also hosts RepoPaths.cs, a filesystem path resolver rather than a test double
      proper — a deliberate imprecision in the name: Scrinia.Tests already references this
      project, so a separate Scrinia.TestUtilities project for one small helper would cost more
      than it saves.
    -->
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Scrinia.Core\Scrinia.Core.csproj" />
  </ItemGroup>
</Project>
