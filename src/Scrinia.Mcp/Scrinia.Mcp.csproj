<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Scrinia.Mcp</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <PackageLicenseExpression>BSD-3-Clause</PackageLicenseExpression>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="scri" />
    <InternalsVisibleTo Include="Scrinia.Tests" />
    <InternalsVisibleTo Include="Scrinia.Server" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ModelContextProtocol" Version="1.0.0" />
    <PackageReference Include="YamlDotNet" Version="16.*" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Scrinia.Core\Scrinia.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="skills\**\*.md" />
    <EmbeddedResource Include="workflows\**\*.yaml" />
    <EmbeddedResource Include="prompts\**\*.md" />
  </ItemGroup>
</Project>
