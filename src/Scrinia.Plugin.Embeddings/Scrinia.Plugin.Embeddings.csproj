<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <PackageLicenseExpression>BSD-3-Clause</PackageLicenseExpression>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Scrinia.Core\Scrinia.Core.csproj" />
    <ProjectReference Include="..\Scrinia.Plugin.Abstractions\Scrinia.Plugin.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The embeddings test project drives the content-verified download through the manager's
         internal EnsureModelAsync overload; keep the download seam internal to production. -->
    <InternalsVisibleTo Include="Scrinia.Plugin.Embeddings.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Named explicitly now. These arrived transitively through a FrameworkReference on
         Microsoft.AspNetCore.App, which this project carried only so it could implement the
         DI and endpoint-mapping half of IScriniaPlugin. That half is gone; the config binding
         it also happened to provide is real and stays, so the two packages that supply it are
         referenced directly instead of pulling in a web framework to get them. -->
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.0" />
    <PackageReference Include="LLamaSharp" Version="0.25.0" />
    <PackageReference Include="LLamaSharp.Backend.Vulkan" Version="0.25.0" />
  </ItemGroup>
</Project>
