<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>scri</AssemblyName>
    <RootNamespace>Scrinia</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <LangVersion>latest</LangVersion>
    <PackageLicenseExpression>BSD-3-Clause</PackageLicenseExpression>
    <IsTrimmable>true</IsTrimmable>

    <!-- Immutable NuGet global tool (Phase 5 Task 4). The single packaged command is `scri`,
         which implements both `scri serve` and `scri shared serve`. Vulkan (LLamaSharp),
         Scrinia.Merge, and every mutable asset (models, plugin state, caches, workspace
         data) live outside this package under SCRINIA_HOME, so the tool payload stays immutable. -->
    <PackageId>scrinia</PackageId>
    <PackageType>DotnetTool</PackageType>
    <ToolCommandName>scri</ToolCommandName>
    <PackAsTool>true</PackAsTool>
    <PackageReadmeFile>package-readme.md</PackageReadmeFile>
    <Description>Scrinia: portable LLM memory. Installs the `scri` global tool (local + shared MCP servers, BM25 + hybrid search, NMP/2 memory), with models and plugins living under SCRINIA_HOME.</Description>
    <Authors>Scrinia</Authors>
    <PackageTags>scrinia;llm;memory;mcp;vector-search;bm25;named-memory-protocol</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <None Remove="NUL" />
  </ItemGroup>

  <ItemGroup>
    <!-- The package readme sits at the package root; PackageReadmeFile references it by name. -->
    <None Include="package-readme.md">
      <Pack>true</Pack>
      <PackagePath />
    </None>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Spectre.Console" Version="0.54.0" />
    <PackageReference Include="ConsoleAppFramework" Version="5.7.13" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Scrinia.Core\Scrinia.Core.csproj" />
    <ProjectReference Include="..\Scrinia.Mcp\Scrinia.Mcp.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Scrinia.Tests" />
    <InternalsVisibleTo Include="Scrinia.TestProcess" />
    <InternalsVisibleTo Include="Scrinia.ReleaseTools" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\..\release\embeddings-payloads.json" LogicalName="Scrinia.EmbeddingsPayloadPolicy.json" />
  </ItemGroup>

  <!-- The SDK marks System.Native DropFromSingleFile, but our Unix regular-file
       guard calls its normalized PAL shim. Retain the asset from this exact build. -->
  <Target Name="PreserveUnixRuntimeShim" AfterTargets="Publish"
          Condition="'$(SelfContained)' == 'true' and '$(PublishSingleFile)' == 'true' and ('$(RuntimeIdentifier)' == 'linux-x64' or '$(RuntimeIdentifier)' == 'osx-arm64')">
    <PropertyGroup>
      <_ScriniaUnixShimName Condition="'$(RuntimeIdentifier)' == 'linux-x64'">libSystem.Native.so</_ScriniaUnixShimName>
      <_ScriniaUnixShimName Condition="'$(RuntimeIdentifier)' == 'osx-arm64'">libSystem.Native.dylib</_ScriniaUnixShimName>
    </PropertyGroup>
    <ItemGroup>
      <_ScriniaUnixRuntimeShim Include="@(RuntimePackAsset)"
          Condition="'%(RuntimePackAsset.DestinationSubPath)' == '$(_ScriniaUnixShimName)' and '%(RuntimePackAsset.AssetType)' == 'native' and '%(RuntimePackAsset.RuntimeIdentifier)' == '$(RuntimeIdentifier)' and '%(RuntimePackAsset.NuGetPackageId)' == 'Microsoft.NETCore.App.Runtime.$(RuntimeIdentifier)' and '%(RuntimePackAsset.NuGetPackageVersion)' != ''" />
    </ItemGroup>
    <Error Condition="'@(_ScriniaUnixRuntimeShim->Count())' != '1'"
           Text="Expected one build-resolved $(_ScriniaUnixShimName) runtime asset for $(RuntimeIdentifier)." />
    <Error Condition="!$([System.IO.File]::Exists('%(_ScriniaUnixRuntimeShim.Identity)'))"
           Text="Resolved Unix runtime shim is missing or is not a file: %(_ScriniaUnixRuntimeShim.Identity)." />
    <Copy SourceFiles="@(_ScriniaUnixRuntimeShim)" DestinationFiles="@(_ScriniaUnixRuntimeShim->'$(PublishDir)$(_ScriniaUnixShimName)')" />
  </Target>
</Project>
