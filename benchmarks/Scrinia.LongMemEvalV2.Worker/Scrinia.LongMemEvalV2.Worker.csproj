    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>scrinia-lme-v2-worker</AssemblyName>
    <RootNamespace>Scrinia.LongMemEvalV2.Worker</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
