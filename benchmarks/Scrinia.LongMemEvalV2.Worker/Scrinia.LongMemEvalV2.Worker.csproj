    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Scrinia.Agent.Runtime/Scrinia.Agent.Runtime.csproj" />
  </ItemGroup>
</Project>
