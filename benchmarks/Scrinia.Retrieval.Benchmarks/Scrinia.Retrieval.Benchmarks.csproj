<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Scrinia.Retrieval.Benchmarks</RootNamespace>
    <AssemblyName>scrinia-bench</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
    <ServerGarbageCollection>true</ServerGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Scrinia.Core\Scrinia.Core.csproj" />
    <ProjectReference Include="..\..\src\Scrinia.Plugin.Embeddings\Scrinia.Plugin.Embeddings.csproj" />
  </ItemGroup>

</Project>
