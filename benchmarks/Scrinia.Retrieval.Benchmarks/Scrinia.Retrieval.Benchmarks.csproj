<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Scrinia.Retrieval.Benchmarks</RootNamespace>
    <AssemblyName>scrinia-bench</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
    <ServerGarbageCollection>true</ServerGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Scrinia.Core\Scrinia.Core.csproj" />
    <ProjectReference Include="..\..\src\Scrinia.Plugin.Embeddings\Scrinia.Plugin.Embeddings.csproj" />
    <ProjectReference Include="..\..\src\Scrinia.Mcp\Scrinia.Mcp.csproj" />
  </ItemGroup>

  <!-- Cross-encoder reranker (bench-only): ONNX Runtime for inference, ML.Tokenizers
       for BERT WordPiece. Bench-side only by design — this is the experiment that
       decides whether a real cross-encoder belongs in Core at all (see
       docs/research/cross-encoding-reranking.md). Kept out of Scrinia.Core so the
       product surface stays unchanged while we measure. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.20.1" />
    <PackageReference Include="Microsoft.ML.Tokenizers" Version="2.0.0" />
  </ItemGroup>

</Project>
